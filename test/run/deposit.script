-- A call script for examples/deposit.lang (S5 4.6, R47 (a)): two deposits, one auction, one tuple,
-- one inactivity timer, a settle, and the reverts that fail before a signature or a proof check.
-- ecrecover and verify are stuck in langc run, thus the signed and proof calls are chain rows in
-- test/deposit.sh. A view after a call shows the changed state.
0 0x00000000000000000000000000000000000000aa regAuction 9u 1 2
0 0x00000000000000000000000000000000000000bb aucItemOf 0u
0 0x00000000000000000000000000000000000000bb aucEndOf 0u
-- nA is 2: a second auction in slot 1 is accepted, a third reverts.
0 0x00000000000000000000000000000000000000aa regAuction 10u 1 1
0 0x00000000000000000000000000000000000000aa regAuction 11u 1 1
-- A deposit below minDeposit reverts.
10 0x00000000000000000000000000000000000000bb registerDeposit 7u 99u
10 0x00000000000000000000000000000000000000bb registerDeposit 7u 100u
10 0x00000000000000000000000000000000000000bb depositOf 0x00000000000000000000000000000000000000bb
11 0x00000000000000000000000000000000000000cc registerDeposit 8u 100u
11 0x00000000000000000000000000000000000000cc depositOf 0x00000000000000000000000000000000000000cc
11 0x00000000000000000000000000000000000000bb rootOf 1
12 0x00000000000000000000000000000000000000aa addTuple 0x00000000000000000000000000000000000000bb 0u 2u
12 0x00000000000000000000000000000000000000bb pendingOf 0x00000000000000000000000000000000000000bb
-- The caller is not a proposer.
20 0x00000000000000000000000000000000000000cc makeInactive 0x00000000000000000000000000000000000000bb
20 0x00000000000000000000000000000000000000aa makeInactive 0x00000000000000000000000000000000000000bb

-- The caller is not the user or a proposer.
20 0x00000000000000000000000000000000000000cc updateActivity 0x00000000000000000000000000000000000000bb 27 1u 2u
-- The timer is 3 (slot 2 + 1), thus a withdraw before slot 4 reverts.
25 0x00000000000000000000000000000000000000bb withdraw 0x00000000000000000000000000000000000000bb 27 1u 2u
-- Two equal commitments are not a double commit. The proof is the fixture: A = 90 G1, B = G2, C = 17 G1.
26 0x00000000000000000000000000000000000000cc slashUsr 2u 1 5u 0x057a7f67bed912cdb1c7f282ada6406e09017f13b7a37385580e7bc079d63978u 0x0ea55197090bd4ed6176a05d1be5a6a1c21aacb5e2ea40a0573d1696221bd87eu 0x198e9393920d483a7260bfb731fb5d25f1aa493335a9e71297e485b7aef312c2u 0x1800deef121f1e76426a00665e5c4479674322d4f75edadd46debd5cd992f6edu 0x090689d0585ff075ec9e99ad690c3395bc4b313370b38ef355acdadcd122975bu 0x12c85ea5db8c6deb4aab71808dcb408fe3d1e7690c43d37b4ce6cc0166fa7daau 0x1c6a451060210f3baad93fe1631753751da9857edae0468e8e4bee7dd33cfb2cu 0x2331a64aa86c50d2d1e0237893ef7744a77228881ce73fcc2ad555a37d4ab405u 1 5u 0x057a7f67bed912cdb1c7f282ada6406e09017f13b7a37385580e7bc079d63978u 0x0ea55197090bd4ed6176a05d1be5a6a1c21aacb5e2ea40a0573d1696221bd87eu 0x198e9393920d483a7260bfb731fb5d25f1aa493335a9e71297e485b7aef312c2u 0x1800deef121f1e76426a00665e5c4479674322d4f75edadd46debd5cd992f6edu 0x090689d0585ff075ec9e99ad690c3395bc4b313370b38ef355acdadcd122975bu 0x12c85ea5db8c6deb4aab71808dcb408fe3d1e7690c43d37b4ce6cc0166fa7daau 0x1c6a451060210f3baad93fe1631753751da9857edae0468e8e4bee7dd33cfb2cu 0x2331a64aa86c50d2d1e0237893ef7744a77228881ce73fcc2ad555a37d4ab405u
-- The auction ends in slot 2: a settle in slot 2 reverts, the first settle in slot 3 is accepted.
29 0x00000000000000000000000000000000000000cc settle 0u 50u
30 0x00000000000000000000000000000000000000cc settle 0u 50u
30 0x00000000000000000000000000000000000000cc winnerOf 0u
30 0x00000000000000000000000000000000000000cc priceOf 0u
