-- Verifier boundary regressions using the synthetic key of groth16.lang.
-- These are chain tests: curve operations remain stuck in the evaluator.
state State := makeState (count : Nat)

def init : State := makeState 0

def g1 : G1Point := pair 1u 2u

-- G2 of BN254 in the EIP-197 input order: (x_im, x_re), (y_im, y_re).
def g2 : G2Point :=
  pair
    (pair 0x198e9393920d483a7260bfb731fb5d25f1aa493335a9e71297e485b7aef312c2u
          0x1800deef121f1e76426a00665e5c4479674322d4f75edadd46debd5cd992f6edu)
    (pair 0x090689d0585ff075ec9e99ad690c3395bc4b313370b38ef355acdadcd122975bu
          0x12c85ea5db8c6deb4aab71808dcb408fe3d1e7690c43d37b4ce6cc0166fa7daau)

def key : VerifyKey :=
  pair (pair (ecMul g1 5u) g2)
    (pair (pair g2 g2) (cons (ecMul g1 7u) (cons (ecMul g1 11u) (cons (ecMul g1 13u) nil))))

def fixture : VerifyProof := pair (ecMul g1 90u) (pair g2 (ecMul g1 17u))

-- Public inputs must be canonical scalars, even though ecMul accepts U256.
-- For (x, 3), the valid A scalar is 68 + 11 * x modulo the scalar order.
def verifyScalar : (env : Env) -> (s : State) -> (x : U256) -> (a : U256) -> Flag :=
  fun (env : Env) (s : State) (x : U256) (a : U256) =>
    verify key (cons x (cons 3u nil)) (pair (ecMul g1 a) (second fixture))

-- IC has two input points. An extra input must not acquire an implicit
-- point at infinity, and omitted inputs must not acquire implicit zeros.
def verifyExtraInput : (env : Env) -> (s : State) -> Flag :=
  fun (env : Env) (s : State) => verify key (cons 2u (cons 3u (cons 1u nil))) fixture
def verifyMissingInput : (env : Env) -> (s : State) -> Flag :=
  fun (env : Env) (s : State) =>
    verify key (cons 2u nil) (pair (ecMul g1 51u) (second fixture))
def verifyMissingAll : (env : Env) -> (s : State) -> Flag :=
  fun (env : Env) (s : State) => verify key nil (pair (ecMul g1 29u) (second fixture))

-- A zero-input key still needs IC0. The key with only IC0 is valid.
def verifyEmptyIC : (env : Env) -> (s : State) -> Flag :=
  fun (env : Env) (s : State) =>
    verify (pair (first key) (pair (first (second key)) nil)) nil
      (pair (ecMul g1 22u) (second fixture))
def verifyNoInputs : (env : Env) -> (s : State) -> Flag :=
  fun (env : Env) (s : State) =>
    verify (pair (first key) (pair (first (second key)) (cons (ecMul g1 7u) nil))) nil
      (pair (ecMul g1 29u) (second fixture))

-- A at infinity is valid for C = -73G and these fixture inputs. A
-- noncanonical y must reach the precompile unchanged and cause a revert.
def verifyPoint : (env : Env) -> (s : State) -> (y : U256) -> Flag :=
  fun (env : Env) (s : State) (y : U256) =>
    verify key (cons 2u (cons 3u nil))
      (pair (pair 0u y) (pair g2 (g1Neg (ecMul g1 73u))))
