-- Appended to examples/deposit.lang by deposit.sh so the tests use the actual entries.
def testResultState : Option (Prod State (List Out)) -> State :=
  fun (r : Option (Prod State (List Out))) => option init (fun (p : Prod State (List Out)) => first p) r
def testAccepted : Option (Prod State (List Out)) -> Flag :=
  fun (r : Option (Prod State (List Out))) => option flagNo (fun (p : Prod State (List Out)) => flagYes) r
def testLeafState : (idx : Nat) -> State :=
  fun (idx : Nat) => makeState 0u 100u 2 0 10 mapEmpty mapEmpty mapEmpty mapEmpty mapEmpty mapEmpty idx
    mapEmpty mapEmpty mapEmpty mapEmpty (proposer init) mapEmpty mapEmpty mapEmpty mapEmpty mapEmpty mapEmpty
def testDepositAt : (idx : Nat) -> Option (Prod State (List Out)) :=
  fun (idx : Nat) => registerDeposit (makeEnv 0 0x00000000000000000000000000000000000000bb 0x0000000000000000000000007265636569766572) (testLeafState idx) 7u 100u
def testLastLeaf : Flag := testAccepted (testDepositAt 4294967295)
def testFullTree : Flag := flagIf (testAccepted (testDepositAt 4294967296)) flagNo flagYes
def testBeyondTree : Flag := flagIf (testAccepted (testDepositAt 4294967297)) flagNo flagYes
def testAuctionCount : (start : Nat) -> (end : Nat) -> (slot : Nat) -> Nat :=
  fun (start : Nat) (end : Nat) (slot : Nat) =>
    mapGet (aucsPerSlot (testResultState (regAuction
      (makeEnv 0 0x00000000000000000000000000000000000000aa 0x0000000000000000000000007265636569766572) init 9u start end))) slot
def testMaxAuction : Flag := natEq (testAuctionCount 18446744073709551615 18446744073709551615 18446744073709551615) 1
def testMaxAuctionSpan : Flag := natEq (testAuctionCount 18446744073709551612 18446744073709551615 18446744073709551612) 1
def testZeroAuction : Flag := natEq (testAuctionCount 0 0 0) 1
def testOutsideAuction : Flag := natEq (testAuctionCount 1 2 0) 0
def testFirstDeposit : State := testResultState
  (registerDeposit (makeEnv 10 0x00000000000000000000000000000000000000bb 0x0000000000000000000000007265636569766572) init 7u 100u)
def testSecondDeposit : State := testResultState
  (registerDeposit (makeEnv 20 0x00000000000000000000000000000000000000cc 0x0000000000000000000000007265636569766572) testFirstDeposit 9u 101u)
def testFirstAmount : Flag := u256Eq (mapGet (amount testFirstDeposit) 0x00000000000000000000000000000000000000bb) 100u
def testSecondIndex : Flag := natEq (nextLeaf testSecondDeposit) 2
def testLeafOf : (a : Addr) -> (c : U256) -> U256 := fun (a : Addr) (c : U256) => poseidon2 (addrToU256 a) c
def testFirstRoot : Flag := u256Eq (mapGet (rootAt testSecondDeposit) 1)
  (rootOfLeaves (cons (testLeafOf 0x00000000000000000000000000000000000000bb 7u) nil))
def testSecondRoot : Flag := u256Eq (mapGet (rootAt testSecondDeposit) 2)
  (rootOfLeaves (cons (testLeafOf 0x00000000000000000000000000000000000000bb 7u)
    (cons (testLeafOf 0x00000000000000000000000000000000000000cc 9u) nil)))
-- S11 step 11.3: u (address 3, C = H(1)) and u' (address 5, C = H(7)) deposit in slot 1, in that
-- order. The root of slot 1 is the root of the circuit fixture (circuits/fixture.circom).
def testCircuitFirst : State := testResultState
  (registerDeposit (makeEnv 10 0x0000000000000000000000000000000000000003 0x0000000000000000000000007265636569766572) init (poseidon1 1u) 100u)
def testCircuitRoot : Flag := u256Eq (mapGet (rootAt (testResultState
  (registerDeposit (makeEnv 10 0x0000000000000000000000000000000000000005 0x0000000000000000000000007265636569766572) testCircuitFirst (poseidon1 7u) 100u))) 1)
  0x1efb9d39eb45e39697c03d8c7236557eba62ac405c584d59b5b96d1c18938d3au
-- A commitment cu = r is not a field element: the deposit reverts.
def testFieldDeposit : Flag := flagIf (testAccepted
  (registerDeposit (makeEnv 0 0x00000000000000000000000000000000000000bb 0x0000000000000000000000007265636569766572) init 0x30644e72e131a029b85045b68181585d2833e84879b9709143e1f593f0000001u 100u)) flagNo flagYes
def testSmallDeposit : Flag := flagIf (testAccepted
  (registerDeposit (makeEnv 0 0x00000000000000000000000000000000000000bb 0x0000000000000000000000007265636569766572) init 7u 99u)) flagNo flagYes
def testDuplicateDeposit : Flag := flagIf (testAccepted
  (registerDeposit (makeEnv 20 0x00000000000000000000000000000000000000bb 0x0000000000000000000000007265636569766572) testFirstDeposit 9u 100u)) flagNo flagYes
def testInactiveState : State := testResultState
  (makeInactive (makeEnv 20 0x00000000000000000000000000000000000000aa 0x0000000000000000000000007265636569766572) testFirstDeposit 0x00000000000000000000000000000000000000bb)
def testInactiveSlot : Flag := natEq (mapGet (inactiveSince testInactiveState) 0x00000000000000000000000000000000000000bb) 3
def testInactiveAgain : Flag := flagIf (testAccepted
  (makeInactive (makeEnv 30 0x00000000000000000000000000000000000000aa 0x0000000000000000000000007265636569766572) testInactiveState 0x00000000000000000000000000000000000000bb)) flagNo flagYes
def testInactiveCaller : Flag := flagIf (testAccepted
  (makeInactive (makeEnv 20 0x00000000000000000000000000000000000000bb 0x0000000000000000000000007265636569766572) testFirstDeposit 0x00000000000000000000000000000000000000bb)) flagNo flagYes
def testInactiveMissing : Flag := flagIf (testAccepted
  (makeInactive (makeEnv 20 0x00000000000000000000000000000000000000aa 0x0000000000000000000000007265636569766572) init 0x00000000000000000000000000000000000000bb)) flagNo flagYes
def testFirstAuction : State := testResultState
  (regAuction (makeEnv 0 0x00000000000000000000000000000000000000aa 0x0000000000000000000000007265636569766572) init 1u 1 3)
def testSecondAuction : State := testResultState
  (regAuction (makeEnv 0 0x00000000000000000000000000000000000000aa 0x0000000000000000000000007265636569766572) testFirstAuction 2u 2 2)
def testFirstSlotCount : Flag := natEq (mapGet (aucsPerSlot testSecondAuction) 1) 1
def testOverlapCount : Flag := natEq (mapGet (aucsPerSlot testSecondAuction) 2) 2
def testLastSlotCount : Flag := natEq (mapGet (aucsPerSlot testSecondAuction) 3) 1
def testAuctionLimit : Flag := flagIf (testAccepted
  (regAuction (makeEnv 0 0x00000000000000000000000000000000000000aa 0x0000000000000000000000007265636569766572) testSecondAuction 3u 2 2)) flagNo flagYes
def testAuctionCaller : Flag := flagIf (testAccepted
  (regAuction (makeEnv 0 0x00000000000000000000000000000000000000bb 0x0000000000000000000000007265636569766572) init 1u 1 3)) flagNo flagYes
def testAuctionReversed : Flag := flagIf (testAccepted
  (regAuction (makeEnv 0 0x00000000000000000000000000000000000000aa 0x0000000000000000000000007265636569766572) init 1u 3 1)) flagNo flagYes
def testAuctionLong : Flag := flagIf (testAccepted
  (regAuction (makeEnv 0 0x00000000000000000000000000000000000000aa 0x0000000000000000000000007265636569766572) init 1u 1 5)) flagNo flagYes

-- Public test key 1, address 0x7e5f...5bdf. The tuple (0, 2) gives piAcc
-- 0x6ee3...68ad. Signatures below use cast wallet sign --no-hash with that
-- test key and hash(piAcc, nonce), with each word encoded as 32 bytes.
def testAuthUser : Addr := 0x7e5f4552091a69125d5dfcb7b8c2659029395bdf
def testAuthPending : State := testResultState
  (addTuple (makeEnv 0 0x00000000000000000000000000000000000000aa 0x0000000000000000000000007265636569766572) init testAuthUser 0u 2u)
def testAuthRepeated : State := testResultState
  (addTuple (makeEnv 0 0x00000000000000000000000000000000000000aa 0x0000000000000000000000007265636569766572)
    (clearUser testAuthPending testAuthUser) testAuthUser 0u 2u)
def testAuthNonce : Flag :=
  flagIf (u256Eq (mapGet (piAcc testAuthPending) testAuthUser) (mapGet (piAcc testAuthRepeated) testAuthUser))
    (natEq (mapGet (piNonce testAuthRepeated) testAuthUser) 1) flagNo
-- Auction 0 of testFirstAuction ends in slot 3. A caller with no deposit cannot settle it in slot 4.
def testSettleNoDeposit : Flag := flagIf (testAccepted
  (settle (makeEnv 40 0x00000000000000000000000000000000000000cc 0x0000000000000000000000007265636569766572) testFirstAuction 0u 50u)) flagNo flagYes
-- S11 step 11.4: limbs gives the (high, low) words of the fixture root, the first two words of
-- statement1 (examples/eligibility.lang).
def testRootLimbs : Flag :=
  flagIf (u256Eq (first (limbs 0x1efb9d39eb45e39697c03d8c7236557eba62ac405c584d59b5b96d1c18938d3au)) 0x1efb9d39eb45e39697c03d8c7236557eu)
    (u256Eq (second (limbs 0x1efb9d39eb45e39697c03d8c7236557eba62ac405c584d59b5b96d1c18938d3au)) 0xba62ac405c584d59b5b96d1c18938d3au) flagNo

-- These views run on the EVM because ecrecover is opaque to langc eval.
def testSignature0 : (env : Env) -> (s : State) -> Flag :=
  fun (env : Env) (s : State) => signedBy testAuthPending testAuthUser 28
    0x394512031ecf8c355f8ebf02dbfcf4881348761e76ebd7ef8b7bfb370eec1c8eu
    0x544f61e1bc9827bdfb3430f2c8c7e3d58945c9cb7ef032b37748e9e8dc5420cfu
def testSignature1 : (env : Env) -> (s : State) -> Flag :=
  fun (env : Env) (s : State) => signedBy testAuthRepeated testAuthUser 27
    0x96e840dd75825d0ab1d6b53a507de4aa1e1768ff3babca6cae6e63ec654652edu
    0x0a8e747b34fddf6101867498e56acce617fba425356b102330aecae58fdde119u
def testSignatureReplay : (env : Env) -> (s : State) -> Flag :=
  fun (env : Env) (s : State) => flagIf (signedBy testAuthRepeated testAuthUser 28
    0x394512031ecf8c355f8ebf02dbfcf4881348761e76ebd7ef8b7bfb370eec1c8eu
    0x544f61e1bc9827bdfb3430f2c8c7e3d58945c9cb7ef032b37748e9e8dc5420cfu) flagNo flagYes
-- A signature over piAcc alone must also be rejected after reconstructing Pi.
def testSignatureLegacy : (env : Env) -> (s : State) -> Flag :=
  fun (env : Env) (s : State) => flagIf (signedBy testAuthRepeated testAuthUser 27
    0x8028a63622d6a827bc6be9d1198143aa0ccb9094fa8e169be6ad0c462cd708e6u
    0x7d118f1952dc10ca0d3ab6d921f6dba825a1e3847d935592123c9ff28d2339feu) flagNo flagYes
