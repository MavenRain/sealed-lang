-- The domain file. sealed-lang S2 (R21) removed the kit sample; the deposit
-- contract of docs/PLAN.md section 6 comes in S5.
-- Each family, constructor, field and def name here becomes a core name
-- (rule R4). Only this file can declare a family (rule R1).

-- Kan library (S2a, R6 (a)): transport, subst, J and the J rule as a path
-- (JRefl, O11), all by transp.
def transport : (X : Type 0) -> (Y : Type 0) -> Path (Type 0) X Y -> X -> Y :=
  fun (X : Type 0) => fun (Y : Type 0) => fun (p : Path (Type 0) X Y) => fun (a : X) => transp (fun (i : I) => p @ i) i0 a
def subst : (A : Type 0) -> (B : A -> Type 0) -> (x : A) -> (y : A) -> Path A x y -> B x -> B y :=
  fun (A : Type 0) => fun (B : A -> Type 0) => fun (x : A) => fun (y : A) => fun (p : Path A x y) => fun (b : B x) =>
    transp (fun (i : I) => B (p @ i)) i0 b
def J : (A : Type 0) -> (x : A) -> (P : (y : A) -> Path A x y -> Type 0) -> P x refl -> (y : A) -> (p : Path A x y) -> P y p :=
  fun (A : Type 0) => fun (x : A) => fun (P : (y : A) -> Path A x y -> Type 0) => fun (d : P x refl) => fun (y : A) => fun (p : Path A x y) =>
    transp (fun (i : I) => P (p @ i) (fun (j : I) => p @ (i /\ j))) i0 d
def JRefl : (A : Type 0) -> (x : A) -> (P : (y : A) -> Path A x y -> Type 0) -> (d : P x refl) -> Path (P x refl) (J A x P d x refl) d :=
  fun (A : Type 0) => fun (x : A) => fun (P : (y : A) -> Path A x y -> Type 0) => fun (d : P x refl) =>
    fun (i : I) => transp (fun (_ : I) => P x refl) i d
-- Path composition (S2b, R2 (a)): trans by hcomp, with the tube x on ~j
-- and q on j, and the base p.
def trans : (A : Type 0) -> (x : A) -> (y : A) -> (z : A) -> Path A x y -> Path A y z -> Path A x z :=
  fun (A : Type 0) => fun (x : A) => fun (y : A) => fun (z : A) => fun (p : Path A x y) => fun (q : Path A y z) =>
    fun (j : I) => hcomp A (~j \/ j) (fun (i : I) => [ ~j -> x, j -> q @ i ]) (p @ j)
-- Propositions and sets (S4b): the squash1 fold case has the type
-- isProp RES, the squash0 and quotSquash fold cases the type isSet RES.
def isProp : (A : Type 0) -> Type 0 :=
  fun (A : Type 0) => (x : A) -> (y : A) -> Path A x y
def isSet : (A : Type 0) -> Type 0 :=
  fun (A : Type 0) => (x : A) -> (y : A) -> isProp (Path A x y)

-- The circle, a higher inductive family (S4a, R1 (a)). The path
-- constructor loop goes from base to base.
family S1 := base | loop (i : I) [ ~i -> base, i -> base ]
-- The propositional truncation (S4b, R5 (a)): squash1 is a path between
-- any two points, so the squash1 fold case has the type isProp RES. A
-- field name is a core name (rule R4), so the names have a family prefix.
family Trunc1 (A : Type 0) := trunc1 (truncOf : A) | squash1 (squashFrom : Trunc1 A) (squashTo : Trunc1 A) (i : I) [ ~i -> squashFrom, i -> squashTo ]
-- The set truncation (S4c, R5 (a)): squash0 is a square between any two
-- paths with the same ends, so the squash0 fold case has the type isSet
-- RES (R8 (a)). The case binds the folded ends and the folded paths.
family Trunc0 (A : Type 0) := trunc0 (trunc0Of : A) | squash0 (squash0From : Trunc0 A) (squash0To : Trunc0 A) (squash0Left : Path (Trunc0 A) squash0From squash0To) (squash0Right : Path (Trunc0 A) squash0From squash0To) (i : I) (j : I) [ ~i -> squash0Left @ j, i -> squash0Right @ j, ~j -> squash0From, j -> squash0To ]
-- The set quotient (S4c, R5 (a)): quotEq is a path from quot A R a to
-- quot A R b for each proof r of R a b. The type of the R parameter uses
-- the A parameter. quotSquash has the squash0 shape at Quot A R, so the
-- quotSquash fold case has the type isSet RES (R8 (a)).
family Quot (A : Type 0) (R : A -> A -> Type 0) := quot (quotOf : A)
  | quotEq (quotA : A) (quotB : A) (quotR : R quotA quotB) (i : I) [ ~i -> quot A R quotA, i -> quot A R quotB ]
  | quotSquash (quotFrom : Quot A R) (quotTo : Quot A R) (quotLeft : Path (Quot A R) quotFrom quotTo) (quotRight : Path (Quot A R) quotFrom quotTo) (i : I) (j : I)
    [ ~i -> quotLeft @ j, i -> quotRight @ j, ~j -> quotFrom, j -> quotTo ]

-- The finite multiset Bag A (S6, R51 (a)): a list with a path that swaps
-- the first two elements, and the set truncation in the squash0 shape. A
-- fold into RES asks c0 : RES, c1 : A -> RES -> RES, a swap case with
-- the type Path RES (c1 x (c1 y r)) (c1 y (c1 x r)), and a trunc case
-- with the type isSet RES.
family Bag (A : Type 0) := bagNil
  | bagCons (bagHead : A) (bagTail : Bag A)
  | bagSwap (bagX : A) (bagY : A) (bagRest : Bag A) (i : I)
    [ ~i -> bagCons A bagX (bagCons A bagY bagRest), i -> bagCons A bagY (bagCons A bagX bagRest) ]
  | bagTrunc (bagFrom : Bag A) (bagTo : Bag A) (bagLeft : Path (Bag A) bagFrom bagTo) (bagRight : Path (Bag A) bagFrom bagTo) (i : I) (j : I)
    [ ~i -> bagLeft @ j, i -> bagRight @ j, ~j -> bagFrom, j -> bagTo ]

-- The bids of a slot (S6 4.2, PLAN section 3): a bid is (value, cm).
-- bidLe is the lexicographic order: on equal values the cm decides, thus
-- the order is total and the larger cm wins a tie (R55 (a); the paper has
-- no tie rule). bidMax a b is the larger of the two bids.
def Bid : Type 0 := Prod U256 U256
def bidLe : (a : Bid) -> (b : Bid) -> Flag :=
  fun (a : Bid) (b : Bid) => flagIf (u256Eq (first a) (first b)) (u256Le (second a) (second b)) (u256Le (first a) (first b))
def bidMax : (a : Bid) -> (b : Bid) -> Bid :=
  fun (a : Bid) (b : Bid) => flagIf (bidLe a b) b a
-- The core laws 1 and 2 (S6 R52 (a), R53 (a)): domain axioms, with no
-- proof in the kernel. Law 1 is true because bidLe is a total order, thus
-- the two sides are the largest of x, y and r. Law 2 is true because two
-- pairs of U256 words have a decidable equality (Hedberg). A fold of a Bag
-- into Bid uses law 1 as the swap case and law 2 as the trunc case. A law
-- has no run-time value: eval keeps it as a neutral and lowering refuses
-- it.
axiom bidMaxSwap : (x : Bid) -> (y : Bid) -> (r : Bid) -> Path Bid (bidMax x (bidMax y r)) (bidMax y (bidMax x r))
axiom bidSet : isSet Bid
-- The sort of the timestamps (S6 4.3, the median of Lemma 11): insNat x l
-- is l with x before the first element that is greater than x, or l with
-- x at the end when no element is greater. The step of the list fold
-- applies to the last element first. The accumulator is (the list from the
-- current element, the same list with x in it).
def insNatSeed : (x : Nat) -> Prod (List Nat) (List Nat) := fun (x : Nat) => pair nil (cons x nil)
def insNat : (x : Nat) -> (l : List Nat) -> List Nat :=
  fun (x : Nat) (l : List Nat) =>
    second (fold
      (fun (y : Nat) (acc : Prod (List Nat) (List Nat)) =>
        pair (cons y (first acc)) (flagIf (natLe y x) (cons y (second acc)) (cons x (cons y (first acc)))))
      (insNatSeed x) l)
-- The core laws 3 and 4 (S6 R52 (a), R53 (a)). Law 3 is true for each list
-- l, also when l is not sorted: the proof is by induction on l, as for the
-- Isabelle lemma List.insort_left_comm. Two equal Nat values are the same
-- value, thus the order of x and y is not important when x = y. Law 4 is
-- true because the lists of Nat have a decidable equality (Hedberg). A
-- fold of a Bag into List Nat uses law 3 as the swap case and law 4 as the
-- trunc case.
axiom insSwap : (x : Nat) -> (y : Nat) -> (l : List Nat) -> Path (List Nat) (insNat x (insNat y l)) (insNat y (insNat x l))
axiom listNatSet : isSet (List Nat)

-- The tree library (S5, R40 (a)): an incremental Merkle tree of keccak
-- hashes with a closed depth (R42 (a)). Level 0 is the leaf level. An
-- empty leaf is 0u, and zeroHash l is the root of an empty subtree of
-- height l. All folds here are over a closed Nat or a closed list, thus
-- normalization unrolls them (32 levels) and an entry or a view can use
-- insertLeaf.
def treeDepth : Nat := 32
-- The levels from treeDepth - 1 down to 0. A list fold applies its step
-- to the last element first, thus level 0 is the inner step.
def treeLevels : List Nat := unfold (fun (n : Nat) => some (pair n (natSub n 1))) treeDepth (natSub treeDepth 1)
def zeroHash : (l : Nat) -> U256 := fun (l : Nat) => fold (fun (acc : U256) => hash acc acc) 0u l
-- flagYes when bit l of idx is 0: the node at level l is a left child.
def treeLeft : (idx : Nat) -> (l : Nat) -> Flag :=
  fun (idx : Nat) (l : Nat) => natEq (natMod (natDiv idx (fold (fun (a : Nat) => natAdd a a) 1 l)) 2) 0
-- One level (the 4.1 form, which the share rule keeps linear in the
-- depth): a left child cur hashes with the empty subtree z, a right child
-- hashes with the filled subtree f.
def treeLevel : (b : Flag) -> (z : U256) -> (f : U256) -> (cur : U256) -> U256 :=
  fun (b : Flag) (z : U256) (f : U256) (cur : U256) => flagIf b (hash cur z) (hash f cur)
-- Insert the leaf cur at the index idx. The result is the new root and
-- the new filled subtrees: a left child at level l becomes filled at l.
-- The insert writes each level, with the old value for a right child.
def insertLeaf : (idx : Nat) -> (cur : U256) -> (filled : Map Nat U256) -> Prod U256 (Map Nat U256) :=
  fun (idx : Nat) (cur : U256) (filled : Map Nat U256) =>
    fold
      (fun (l : Nat) (acc : Prod U256 (Map Nat U256)) =>
        pair (treeLevel (treeLeft idx l) (zeroHash l) (mapGet filled l) (first acc))
          (mapSet (second acc) l (flagIf (treeLeft idx l) (first acc) (mapGet filled l))))
      (pair cur filled) treeLevels
-- The root of a closed list of leaves (the eval side of the tree rows):
-- each level hashes the nodes in pairs, and an odd last node hashes with
-- zeroHash l. The pair fold reads the list from the end, thus it starts
-- with the pending node zeroHash l when the length is odd.
def treePairSeed : (z : U256) -> (odd : Flag) -> Prod (List U256) (Prod U256 Flag) :=
  fun (z : U256) (odd : Flag) => pair nil (pair z odd)
def treePairStep : (x : U256) -> (acc : Prod (List U256) (Prod U256 Flag)) -> Prod (List U256) (Prod U256 Flag) :=
  fun (x : U256) (acc : Prod (List U256) (Prod U256 Flag)) =>
    flagIf (second (second acc))
      (pair (cons (hash x (first (second acc))) (first acc)) (pair 0u flagNo))
      (pair (first acc) (pair x flagYes))
def treePairLevel : (l : Nat) -> (xs : List U256) -> List U256 :=
  fun (l : Nat) (xs : List U256) =>
    first (fold treePairStep
      (treePairSeed (zeroHash l) (natEq (natMod (fold (fun (x : U256) (n : Nat) => natAdd n 1) 0 xs) 2) 1)) xs)
def rootOfLeaves : (leaves : List U256) -> U256 :=
  fun (leaves : List U256) =>
    fold (fun (x : U256) (acc : U256) => x) (zeroHash treeDepth) (fold treePairLevel leaves treeLevels)

-- The verifier library (S5 4.3, R40 (a)): verify of a Groth16 proof on
-- BN254 with the precompiles ecAdd, ecMul and ecPairing (EIP-196, EIP-197).
-- A G2 point is in the EIP-197 input order: (x_im, x_re), (y_im, y_re).
-- The key is ((alpha, beta), ((gamma, delta), ic)): ic is IC0, then one
-- point for each public input. The proof is (A, (B, C)).
def G1Point : Type 0 := Prod U256 U256
def G2Point : Type 0 := Prod (Prod U256 U256) (Prod U256 U256)
def VerifyKey : Type 0 := Prod (Prod G1Point G2Point) (Prod (Prod G2Point G2Point) (List G1Point))
def VerifyProof : Type 0 := Prod G1Point (Prod G2Point G1Point)
-- The first element of xs, or d for nil (the step of a list fold applies
-- to the last element first, thus the first element is the last result).
def listHead : (A : Type 0) -> (d : A) -> (xs : List A) -> A :=
  fun (A : Type 0) (d : A) (xs : List A) => fold (fun (x : A) (acc : A) => x) d xs
def listTailSeed : (A : Type 0) -> Prod (List A) (List A) := fun (A : Type 0) => pair nil nil
-- xs without its first element (nil for nil). The accumulator is (the
-- list after the current element, the list from the current element).
def listTail : (A : Type 0) -> (xs : List A) -> List A :=
  fun (A : Type 0) (xs : List A) =>
    first (fold (fun (x : A) (acc : Prod (List A) (List A)) => pair (second acc) (cons x (second acc))) (listTailSeed A) xs)
-- The pairs (input i, point i of ics), in the order of the inputs.
-- verify checks that the input and point counts match before using them.
def zipInputs : (inputs : List U256) -> (ics : List G1Point) -> List (Prod U256 G1Point) :=
  fun (inputs : List U256) (ics : List G1Point) =>
    unfold
      (fun (st : Prod (List U256) (List G1Point)) =>
        some (pair (pair (listHead U256 0u (first st)) (listHead G1Point (pair 0u 0u) (second st)))
                   (pair (listTail U256 (first st)) (listTail G1Point (second st)))))
      (fold (fun (x : U256) (n : Nat) => natAdd n 1) 0 inputs) (pair inputs ics)
-- -a = (x, p - y), with p the BN254 base field modulus. The point at
-- infinity (0, 0) stays (0, 0). Preserve a noncanonical y so that the
-- precompile rejects it, rather than saturating p - y to zero.
def g1Neg : (a : G1Point) -> G1Point :=
  fun (a : G1Point) =>
    pair (first a)
      (flagIf (u256Le (second a) 0x30644e72e131a029b85045b68181585d97816a916871ca8d3c208c16d87cfd46u)
        (flagIf (u256Eq (second a) 0u) 0u
          (u256Sub 0x30644e72e131a029b85045b68181585d97816a916871ca8d3c208c16d87cfd47u (second a)))
        (second a))
-- vk_x = IC0 + the sum of input i times IC point i + 1. The proof is
-- valid when e(-A, B) e(alpha, beta) e(vk_x, gamma) e(C, delta) = 1. For
-- a closed list of inputs, normalization unrolls the folds. Require IC0
-- and exactly one IC point per input, and inputs below the BN254 scalar
-- order (distinct from the base field modulus). Otherwise return flagNo.
-- A point that
-- is not on the curve makes the precompile fail, and the call reverts
-- (R18). The evaluator keeps verify stuck (R17).
def verify : (vk : VerifyKey) -> (inputs : List U256) -> (proof : VerifyProof) -> Flag :=
  fun (vk : VerifyKey) (inputs : List U256) (proof : VerifyProof) =>
    flagIf
      (natEq (fold (fun (p : G1Point) (n : Nat) => natAdd n 1) 0 (second (second vk)))
        (natAdd 1 (fold (fun (x : U256) (n : Nat) => natAdd n 1) 0 inputs)))
      (flagIf
        (fold (fun (x : U256) (ok : Flag) =>
          flagIf (u256Le x 0x30644e72e131a029b85045b68181585d2833e84879b9709143e1f593f0000000u) ok flagNo)
          flagYes inputs)
        (ecPairing
      (cons (pair (g1Neg (first proof)) (first (second proof)))
        (cons (pair (first (first vk)) (second (first vk)))
          (cons (pair (fold (fun (p : Prod U256 G1Point) (acc : G1Point) => ecAdd acc (ecMul (second p) (first p)))
                        (listHead G1Point (pair 0u 0u) (second (second vk)))
                        (zipInputs inputs (listTail G1Point (second (second vk)))))
                      (first (first (second vk))))
            (cons (pair (second (second proof)) (second (first (second vk)))) nil)))))
        flagNo)
      flagNo

-- A Nat-indexed family (former F15, S9 R86 (a)), the kit shape: Lot 3 is
-- a lot of size 3. The constructor takes the index first: makeLot 3 250.
-- It is at the end of the file, thus no cite of this file moves.
family Lot (size : Nat) := makeLot (lotPrice : Nat)
