-- The verifier library (S5 4.3, R39 (a) candidate 1, R40 (a)): verify is in domain/domain.lang.
-- A synthetic BN254 fixture with 2 public inputs. Each G1 point is a multiple of G1 = (1, 2), made on the
-- chain by ecMul, and each G2 point is the generator G2. Scalars: alpha 5, IC0 7, IC1 11, IC2 13, A 90,
-- C 17, inputs (2, 3). Then vk_x = 7 + 2 * 11 + 3 * 13 = 68 and -90 + 5 + 68 + 17 = 0: accept. With the
-- inputs in the other order, vk_x = 7 + 3 * 11 + 2 * 13 = 66 and the sum is -2: reject. This is not a
-- real setup (one G2 point), but it tests all of verify: the fold, -A, the 4 pairs and the input order.
-- test/precompile.sh compares the two views on the chain. `langc eval` keeps verify stuck (R17).
state State := makeState (count : Nat)

def init : State := makeState 0

def g1 : G1Point := pair 1u 2u

-- G2 of BN254 in the EIP-197 input order: (x_im, x_re), (y_im, y_re).
def g2 : G2Point :=
  pair
    (pair 0x198e9393920d483a7260bfb731fb5d25f1aa493335a9e71297e485b7aef312c2u
          0x1800deef121f1e76426a00665e5c4479674322d4f75edadd46debd5cd992f6edu)
    (pair 0x090689d0585ff075ec9e99ad690c3395bc4b313370b38ef355acdadcd122975bu
          0x12c85ea5db8c6deb4aab71808dcb408fe3d1e7690c43d37b4ce6cc0166fa7daau)

def key : VerifyKey :=
  pair (pair (ecMul g1 5u) g2)
    (pair (pair g2 g2) (cons (ecMul g1 7u) (cons (ecMul g1 11u) (cons (ecMul g1 13u) nil))))

def fixture : VerifyProof := pair (ecMul g1 90u) (pair g2 (ecMul g1 17u))

-- 1: the inputs (2, 3) are the inputs of the fixture.
def verifyOk : (env : Env) -> (s : State) -> Flag :=
  fun (env : Env) (s : State) => verify key (cons 2u (cons 3u nil)) fixture

-- 0: the same proof with the two inputs in the other order.
def verifyBadOrder : (env : Env) -> (s : State) -> Flag :=
  fun (env : Env) (s : State) => verify key (cons 3u (cons 2u nil)) fixture
