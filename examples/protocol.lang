-- The protocol layer (S6, R60 (a)): the off-chain logic of the IL
-- proposer. The EVM never sees these defs: a path or a Bag value in an
-- entry is REFUSE_LOWER.
-- The bid pool of a slot (S6 4.2, PLAN section 3) is a Bag of bids. The
-- winner is bagMax pool, the fold of bidMax over the pool. The fold goes
-- into Bid, thus the swap case is law 1 (bidMaxSwap) and the trunc case is
-- law 2 (bidSet). The empty pool gives (0, 0).
def bagMax : (pool : Bag Bid) -> Bid :=
  fun (pool : Bag Bid) => fold (pair 0u 0u) bidMax
    (fun (x : Bid) (y : Bid) (r : Bid) => bidMaxSwap x y r) bidSet pool
-- An instance of law 1 at closed bids. The proof is refl, thus a bidMax
-- that makes law 1 false at these bids fails the check. This row does not
-- prove the law.
def bidMaxSwapAt : Path Bid (bidMax (pair 5u 1u) (bidMax (pair 7u 2u) (pair 3u 9u)))
  (bidMax (pair 7u 2u) (bidMax (pair 5u 1u) (pair 3u 9u))) := refl
-- The eval rows: the largest of three bids (not the first bid), a tie on
-- value (the larger cm wins, R55 (a)) and the empty pool.
def winnerOf3 : Bid := bagMax (bagCons Bid (pair 5u 1u) (bagCons Bid (pair 7u 2u) (bagCons Bid (pair 3u 9u) (bagNil Bid))))
def tieBid : Bid := bagMax (bagCons Bid (pair 7u 2u) (bagCons Bid (pair 7u 4u) (bagNil Bid)))
def emptyPool : Bid := bagMax (bagNil Bid)
-- The timestamps of a slot (S6 4.3, Lemma 11) are a Bag of Nat. sortBag b
-- is the sorted list of the stamps, the fold of insNat over b. The fold
-- goes into List Nat, thus the swap case is law 3 (insSwap) and the trunc
-- case is law 4 (listNatSet).
def sortBag : (b : Bag Nat) -> List Nat :=
  fun (b : Bag Nat) => fold nil insNat
    (fun (x : Nat) (y : Nat) (r : List Nat) => insSwap x y r) listNatSet b
-- The median (R54 (a)): the stamp at index f of sortBag b. The f folds of
-- listTail remove the f smallest stamps, and the list fold gives the first
-- stamp that stays. A bag with f stamps or less gives none (a missing
-- stamp is infinite, as in Lemma 11). An even count uses the same rule: f
-- sets the index, not the count.
def medianAt : (f : Nat) -> (b : Bag Nat) -> Option Nat :=
  fun (f : Nat) (b : Bag Nat) =>
    fold (fun (x : Nat) (acc : Option Nat) => some x) none
      (fold (fun (l : List Nat) => listTail Nat l) (sortBag b) f)
-- An instance of law 3 at closed values, with a list that is not sorted.
-- The proof is refl, thus an insNat that makes law 3 false at these values
-- fails the check. This row does not prove the law.
def insSwapAt : Path (List Nat) (insNat 5 (insNat 2 (cons 7 (cons 1 nil))))
  (insNat 2 (insNat 5 (cons 7 (cons 1 nil)))) := refl
-- The eval rows, all with f = 1 except the last: an odd count, an even
-- count, a missing stamp (two stamps of three) and too few stamps (f = 2,
-- two stamps). The median at index f + 1 fails the odd, even and missing
-- rows. An insNat that sorts down fails the even and missing rows.
def medianOdd : Option Nat := medianAt 1 (bagCons Nat 9 (bagCons Nat 3 (bagCons Nat 5 (bagNil Nat))))
def medianEven : Option Nat := medianAt 1 (bagCons Nat 8 (bagCons Nat 2 (bagCons Nat 6 (bagCons Nat 4 (bagNil Nat)))))
def medianMissing : Option Nat := medianAt 1 (bagCons Nat 7 (bagCons Nat 4 (bagNil Nat)))
def medianTooFew : Option Nat := medianAt 2 (bagCons Nat 3 (bagCons Nat 6 (bagNil Nat)))
-- The word that a timestamper signs (S6 4.4, R55 (a)): hash cm (toU256 t),
-- the pair (cm, t) of Algorithm 2. The signature is made outside the
-- language.
def signComWord : (cm : U256) -> (t : Nat) -> U256 :=
  fun (cm : U256) (t : Nat) => hash cm (toU256 t)
-- flagYes when (v, r, s) is a signature of the timestamper ts over the word
-- w (the signedBy shape of deposit.lang). An invalid signature recovers the
-- address 0, thus the address 0 never signs. ecrecover does not step in
-- eval (O5), thus no eval row runs stampBy, and processBid takes the stamp
-- check as a parameter (R56 (a)).
def stampBy : (w : U256) -> (v : Nat) -> (r s : U256) -> (ts : Addr) -> Flag :=
  fun (w : U256) (v : Nat) (r s : U256) (ts : Addr) =>
    flagIf (u256Eq (addrToU256 ts) 0u) flagNo (addrEq (ecrecover w v r s) ts)
-- The eval rows: the same two values in the two orders. A signComWord that
-- hashes toU256 t before cm gives the value of the other row, thus it fails
-- the two rows.
def signComA : U256 := signComWord 12u 7
def signComB : U256 := signComWord 7u 12
-- flagYes when a is an element of xs.
def addrIn : (a : Addr) -> (xs : List Addr) -> Flag :=
  fun (a : Addr) (xs : List Addr) =>
    fold (fun (x : Addr) (acc : Flag) => flagIf (addrEq x a) flagYes acc) flagNo xs
-- flagYes when a handle of pi is an element of slashed.
def piSlashed : (pi : List U256) -> (slashed : List U256) -> Flag :=
  fun (pi : List U256) (slashed : List U256) =>
    fold (fun (h : U256) (acc : Flag) =>
      flagIf (fold (fun (x : U256) (b : Flag) => flagIf (u256Eq x h) flagYes b) flagNo slashed) flagYes acc)
      flagNo pi
-- flagYes when the bid is late: the median of the stamps is none or above
-- tEnd, or the clock is above the slot time.
def tooLate : (f : Nat) -> (stamps : Bag Nat) -> (tEnd clock slot : Nat) -> Flag :=
  fun (f : Nat) (stamps : Bag Nat) (tEnd clock slot : Nat) =>
    flagIf (natLe clock slot)
      (option flagYes (fun (m : Nat) => flagIf (natLe m tEnd) flagNo flagYes) (medianAt f stamps))
      flagYes
-- flagYes when each stamp word signComWord cm t passes stampOk. The fold
-- goes over the list sortBag stamps, thus laws 3 and 4 cover it. A fold
-- of the Bag into Flag needs a fifth law (out of R53 (a)).
def stampsOk : (stampOk : U256 -> Flag) -> (cm : U256) -> (stamps : Bag Nat) -> Flag :=
  fun (stampOk : U256 -> Flag) (cm : U256) (stamps : Bag Nat) =>
    fold (fun (t : Nat) (acc : Flag) => flagIf (stampOk (signComWord cm t)) acc flagNo) flagYes (sortBag stamps)
-- The bid check of the IL proposer (S6 4.5, Algorithm 3, R56 (a)). zkOk
-- is the check of the auction proof and gets cm. stampOk is the check of
-- one stamp word (stampBy with the signature and the timestamper of that
-- stamp). The two checks do not step in eval (O5), thus they are
-- parameters and the eval rows give fixtures. The output is inr the new
-- pool, or inl the code of the first test that fails, in the paper order:
-- 1 the auction proof fails, 2 a handle of pi is slashed (abort, the slash
-- call of deposit.lang follows), 3 au is not a depositor, 4 the bid is
-- late, 5 a stamp word fails stampOk. No test reads aucId: the proposer
-- keeps one pool for each auction.
def processBid : (zkOk : U256 -> Flag) -> (stampOk : U256 -> Flag) -> (pool : Bag Bid) ->
  (deposits : List Addr) -> (slashed : List U256) -> (value cm : U256) -> (au : Addr) ->
  (aucId : U256) -> (tEnd : Nat) -> (stamps : Bag Nat) -> (pi : List U256) -> (f clock slot : Nat) ->
  Sum Nat (Bag Bid) :=
  fun (zkOk : U256 -> Flag) (stampOk : U256 -> Flag) (pool : Bag Bid) (deposits : List Addr)
      (slashed : List U256) (value cm : U256) (au : Addr) (aucId : U256) (tEnd : Nat)
      (stamps : Bag Nat) (pi : List U256) (f clock slot : Nat) =>
    flagIf (zkOk cm)
      (flagIf (piSlashed pi slashed) (inl 2)
        (flagIf (addrIn au deposits)
          (flagIf (tooLate f stamps tEnd clock slot) (inl 4)
            (flagIf (stampsOk stampOk cm stamps) (inr (bagCons Bid (pair value cm) pool)) (inl 5)))
          (inl 3)))
      (inl 1)
-- The fixtures of the eval rows: the bid (9u, 12u) of the depositor
-- 0x...a1, the stamps {9, 3, 5} (f = 1, the median is 5), tEnd 6, the
-- clock 20 and the slot time 24. zkFix accepts the proof of cm 12u only.
-- stampFix accepts the stamp words of cm 12u only, written with hash (not
-- signComWord), thus a signComWord over the wrong word fails the accept
-- row. stampOther accepts the stamp words of cm 13u (the stamps of an
-- other bid).
def zkFix : (w : U256) -> Flag := fun (w : U256) => u256Eq w 12u
def zkOther : (w : U256) -> Flag := fun (w : U256) => u256Eq w 13u
def stampFix : (w : U256) -> Flag :=
  fun (w : U256) => flagIf (u256Eq w (hash 12u (toU256 3))) flagYes
    (flagIf (u256Eq w (hash 12u (toU256 5))) flagYes (u256Eq w (hash 12u (toU256 9))))
def stampOther : (w : U256) -> Flag :=
  fun (w : U256) => flagIf (u256Eq w (hash 13u (toU256 3))) flagYes
    (flagIf (u256Eq w (hash 13u (toU256 5))) flagYes (u256Eq w (hash 13u (toU256 9))))
def poolFix : Bag Bid := bagCons Bid (pair 5u 1u) (bagNil Bid)
def depositsFix : List Addr := cons 0x00000000000000000000000000000000000000a1 (cons 0x00000000000000000000000000000000000000a2 nil)
def slashedFix : List U256 := cons 41u nil
def stampsFix : Bag Nat := bagCons Nat 9 (bagCons Nat 3 (bagCons Nat 5 (bagNil Nat)))
-- The eval rows: the accept row, then one row for each code. A reject row
-- changes one input of the accept row, thus only its own test fails, and a
-- processBid that skips that test accepts the bid.
def procAccept : Sum Nat (Bag Bid) := processBid zkFix stampFix poolFix depositsFix slashedFix
  9u 12u 0x00000000000000000000000000000000000000a1 3u 6 stampsFix (cons 30u (cons 31u nil)) 1 20 24
def procProof : Sum Nat (Bag Bid) := processBid zkOther stampFix poolFix depositsFix slashedFix
  9u 12u 0x00000000000000000000000000000000000000a1 3u 6 stampsFix (cons 30u (cons 31u nil)) 1 20 24
def procSlashed : Sum Nat (Bag Bid) := processBid zkFix stampFix poolFix depositsFix slashedFix
  9u 12u 0x00000000000000000000000000000000000000a1 3u 6 stampsFix (cons 30u (cons 41u nil)) 1 20 24
def procDepositor : Sum Nat (Bag Bid) := processBid zkFix stampFix poolFix depositsFix slashedFix
  9u 12u 0x00000000000000000000000000000000000000a3 3u 6 stampsFix (cons 30u (cons 31u nil)) 1 20 24
def procLate : Sum Nat (Bag Bid) := processBid zkFix stampFix poolFix depositsFix slashedFix
  9u 12u 0x00000000000000000000000000000000000000a1 3u 4 stampsFix (cons 30u (cons 31u nil)) 1 20 24
def procStamp : Sum Nat (Bag Bid) := processBid zkFix stampOther poolFix depositsFix slashedFix
  9u 12u 0x00000000000000000000000000000000000000a1 3u 6 stampsFix (cons 30u (cons 31u nil)) 1 20 24
-- The property checks (S6 4.6, R59 (a)). Each row is a Flag that gives
-- flagYes. Simultaneous Release and No Free Bid Withdrawal are partly
-- terms; t_h-Hiding and Auction Participation Efficiency are not terms.
-- flagYes when o is some m and lo <= m <= hi. A missing median (none) is
-- infinite (Lemma 11), thus it is not in the range.
def inRange : (lo hi : Nat) -> (o : Option Nat) -> Flag :=
  fun (lo hi : Nat) (o : Option Nat) =>
    option flagNo (fun (m : Nat) => flagIf (natLe lo m) (natLe m hi) flagNo) o
-- flagYes when s is inl code (processBid rejects the bid with that code).
def isCode : (code : Nat) -> (s : Sum Nat (Bag Bid)) -> Flag :=
  fun (code : Nat) (s : Sum Nat (Bag Bid)) =>
    either (fun (n : Nat) => natEq n code) (fun (p : Bag Bid) => flagNo) s
-- flagYes when s is inr (processBid puts the bid in the pool).
def isAccept : (s : Sum Nat (Bag Bid)) -> Flag :=
  fun (s : Sum Nat (Bag Bid)) =>
    either (fun (n : Nat) => flagNo) (fun (p : Bag Bid) => flagYes) s
-- Simultaneous Release, Lemma 11 at f = 1: 2f + 1 = 3 timestampers, the
-- honest stamps 10 and 12, and the stamp of the adversary 0 (below), 1000
-- (above) or missing. In the three cases the median is in [10, 12]. The
-- median at index f + 1 gives 1000 or none, thus it fails the row.
def lemma11F1 : Flag :=
  flagIf (inRange 10 12 (medianAt 1 (bagCons Nat 10 (bagCons Nat 12 (bagCons Nat 0 (bagNil Nat))))))
    (flagIf (inRange 10 12 (medianAt 1 (bagCons Nat 10 (bagCons Nat 12 (bagCons Nat 1000 (bagNil Nat))))))
      (inRange 10 12 (medianAt 1 (bagCons Nat 10 (bagCons Nat 12 (bagNil Nat)))))
      flagNo)
    flagNo
-- Lemma 11 at f = 2: 2f + 1 = 5 timestampers, the honest stamps 10, 11
-- and 13, and the two stamps 0 of the adversary. The median is in [10, 13].
def lemma11F2 : Flag :=
  inRange 10 13 (medianAt 2 (bagCons Nat 10 (bagCons Nat 0 (bagCons Nat 11 (bagCons Nat 0 (bagCons Nat 13 (bagNil Nat)))))))
-- Simultaneous Release, the late cut of processBid: stampsFix gives the
-- median tau = 5. tEnd 5 (tau = tEnd) accepts the bid, and tEnd 4 (tau =
-- tEnd + 1) gives code 4. A processBid with no tau <= tEnd test accepts the
-- second bid, and a test tau < tEnd rejects the first bid.
def lateCut : Flag :=
  flagIf (isAccept (processBid zkFix stampFix poolFix depositsFix slashedFix
      9u 12u 0x00000000000000000000000000000000000000a1 3u 5 stampsFix (cons 30u (cons 31u nil)) 1 20 24))
    (isCode 4 (processBid zkFix stampFix poolFix depositsFix slashedFix
      9u 12u 0x00000000000000000000000000000000000000a1 3u 4 stampsFix (cons 30u (cons 31u nil)) 1 20 24))
    flagNo
-- No Free Bid Withdrawal, the abort of processBid: a pi with the slashed
-- handle 41u gives code 2, with the handle first or last in pi. A
-- processBid that skips the slashed test accepts the bid.
def slashedAbort : Flag :=
  flagIf (isCode 2 (processBid zkFix stampFix poolFix depositsFix slashedFix
      9u 12u 0x00000000000000000000000000000000000000a1 3u 6 stampsFix (cons 41u (cons 30u nil)) 1 20 24))
    (isCode 2 (processBid zkFix stampFix poolFix depositsFix slashedFix
      9u 12u 0x00000000000000000000000000000000000000a1 3u 6 stampsFix (cons 30u (cons 41u nil)) 1 20 24))
    flagNo
-- n_c = 3 nA - 1: the most unrevealed certificates (Lemma 13). There is
-- no natMul, thus 3 nA is nA + nA + nA.
def ncOf : (nA : Nat) -> Nat :=
  fun (nA : Nat) => natSub (natAdd nA (natAdd nA nA)) 1
-- No Free Bid Withdrawal at the deposit start state: init of
-- examples/deposit.lang has nA 2 (makeState 0u 100u 2 ...), thus n_c = 5.
-- A program cannot import an other program (R40), thus the row gives nA 2
-- as a literal. The bound minDeposit >= n_c u is not a term.
def ncCount : Flag := natEq (ncOf 2) 5
