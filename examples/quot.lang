-- The set truncation Trunc0 and the set quotient Quot (S4c, rulings R5,
-- R6 and R8): a dimension-2 constructor (squash0, quotSquash) between any
-- two paths with the same ends, a fold into Trunc0 B, and a quotient of
-- Nat by parity.
-- The fold sends trunc0 a to trunc0 (f a) and squash0 to squash0. The
-- squash0 case has the type isSet (Trunc0 B).
def map0 : (A : Type 0) -> (B : Type 0) -> (f : A -> B) -> Trunc0 A -> Trunc0 B :=
  fun (A : Type 0) (B : Type 0) (f : A -> B) (t : Trunc0 A) => fold (fun (a : A) => trunc0 B (f a))
    (fun (x : Trunc0 B) (y : Trunc0 B) (p : Path (Trunc0 B) x y) (q : Path (Trunc0 B) x y) => fun (i : I) => fun (j : I) => squash0 B x y p q i j) t
def map0At : Path (Trunc0 Nat) (map0 Nat Nat (fun (r : Nat) => natMod (natAdd r 1) 2) (trunc0 Nat 0)) (trunc0 Nat 1) := refl
-- refl and trans refl refl are not equal by conversion (there is no
-- regularity), but squash0 gives a square between them.
def sq0 : Path (Path (Trunc0 Nat) (trunc0 Nat 0) (trunc0 Nat 0)) refl
  (trans (Trunc0 Nat) (trunc0 Nat 0) (trunc0 Nat 0) (trunc0 Nat 0) refl refl) :=
  fun (i : I) => fun (j : I) => squash0 Nat (trunc0 Nat 0) (trunc0 Nat 0) refl
    (trans (Trunc0 Nat) (trunc0 Nat 0) (trunc0 Nat 0) (trunc0 Nat 0) refl refl) i j
-- The fold of a squash0 square folds the path fields too: p goes to
-- fun k => map0 (p @ k).
def map0Sq : (x : Trunc0 Nat) -> (p : Path (Trunc0 Nat) x x) ->
  Path (Path (Path (Trunc0 Nat) (map0 Nat Nat (fun (r : Nat) => natMod (natAdd r 1) 2) x) (map0 Nat Nat (fun (r : Nat) => natMod (natAdd r 1) 2) x))
      (fun (k : I) => map0 Nat Nat (fun (r : Nat) => natMod (natAdd r 1) 2) (p @ k)) (fun (k : I) => map0 Nat Nat (fun (r : Nat) => natMod (natAdd r 1) 2) (p @ k)))
    (fun (i : I) => fun (j : I) => map0 Nat Nat (fun (r : Nat) => natMod (natAdd r 1) 2) (squash0 Nat x x p p i j))
    (fun (i : I) => fun (j : I) => squash0 Nat (map0 Nat Nat (fun (r : Nat) => natMod (natAdd r 1) 2) x) (map0 Nat Nat (fun (r : Nat) => natMod (natAdd r 1) 2) x)
      (fun (k : I) => map0 Nat Nat (fun (r : Nat) => natMod (natAdd r 1) 2) (p @ k)) (fun (k : I) => map0 Nat Nat (fun (r : Nat) => natMod (natAdd r 1) 2) (p @ k)) i j) :=
  fun (x : Trunc0 Nat) (p : Path (Trunc0 Nat) x x) => refl
-- Parity on Nat: a + a is 0 for an even a and 2 for an odd a. Par
-- relates two points with the same parity.
def parity : Nat -> Nat := fun (a : Nat) => natMod (natAdd a a) 4
def Par : Nat -> Nat -> Type 0 := fun (a : Nat) (b : Nat) => Path Nat (parity a) (parity b)
def qPath : Path (Quot Nat Par) (quot Nat Par 0) (quot Nat Par 2) :=
  fun (i : I) => quotEq Nat Par 0 2 refl i
-- The fold of Quot into Trunc0 Nat: the point case is trunc0 (parity
-- a), the quotEq case is the path r, the quotSquash case is squash0.
def toTrunc : Quot Nat Par -> Trunc0 Nat :=
  fun (z : Quot Nat Par) => fold (fun (a : Nat) => trunc0 Nat (parity a))
    (fun (a : Nat) (b : Nat) (r : Par a b) => fun (i : I) => trunc0 Nat (r @ i))
    (fun (x : Trunc0 Nat) (y : Trunc0 Nat) (p : Path (Trunc0 Nat) x y) (q : Path (Trunc0 Nat) x y) => fun (i : I) => fun (j : I) => squash0 Nat x y p q i j) z
def toTrunc2 : Path (Trunc0 Nat) (toTrunc (quot Nat Par 2)) (trunc0 Nat 0) := refl
def toTrunc3 : Trunc0 Nat := toTrunc (quot Nat Par 3)
-- The fold of qPath is the constant path at trunc0 Nat 0.
def toTruncPath : Path (Path (Trunc0 Nat) (trunc0 Nat 0) (trunc0 Nat 0))
  (fun (i : I) => toTrunc (quotEq Nat Par 0 2 refl i)) refl := refl
