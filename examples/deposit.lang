-- The limbs (high, low) of the word w: w = high * 2^128 + low and low < 2^128 (O102). The base
-- pair u256High and u256Low (S11 step 11.4) is SHR by 128 and AND with 2^128 - 1 on the EVM.
def limbs : (w : U256) -> Prod U256 U256 :=
  fun (w : U256) => pair (u256High w) (u256Low w)
-- The limbs of p (high, then low) before rest.
def limbsThen : (p : Prod U256 U256) -> (rest : List U256) -> List U256 :=
  fun (p : Prod U256 U256) (rest : List U256) => cons (first p) (cons (second p) rest)

-- The proof (A, (B, C)) of 8 call words. A and C are G1 points. B is a G2 point in the EIP-197 order.
def proofOf : (ax ay bxi bxr byi byr cx cy : U256) -> VerifyProof :=
  fun (ax ay bxi bxr byi byr cx cy : U256) =>
    pair (pair ax ay) (pair (pair (pair bxi bxr) (pair byi byr)) (pair cx cy))

-- flagYes when p is a valid proof for the statement of (the root of slot, hu, cm). The contract
-- makes the six limb words (O102), thus the caller gives no input words.
def eligible : (s : State) -> (hu : U256) -> (slot : Nat) -> (cm : U256) -> (p : VerifyProof) -> Flag :=
  fun (s : State) (hu : U256) (slot : Nat) (cm : U256) (p : VerifyProof) =>
    verify slashKey (limbsThen (limbs (mapGet (rootAt s) slot)) (limbsThen (limbs hu) (limbsThen (limbs cm) nil))) p

-- flagYes when the caller is the user au or a proposer.
def byUserOrProposer : (env : Env) -> (s : State) -> (au : Addr) -> Flag :=
  fun (env : Env) (s : State) (au : Addr) =>
    flagIf (addrEq (caller env) au) flagYes (mapGet (proposer s) (caller env))

-- flagYes when (v, r, w) is a signature of au over hash piAcc[au] piNonce[au]. Binding the
-- nonce prevents a signature from authorizing a later Pi with the same tuples after a reset.
-- w is the s word of the signature. An invalid signature recovers the address 0 (R18), thus the
-- address 0 never signs.
def signedBy : (s : State) -> (au : Addr) -> (v : Nat) -> (r w : U256) -> Flag :=
  fun (s : State) (au : Addr) (v : Nat) (r w : U256) =>
    flagIf (u256Eq (addrToU256 au) 0u) flagNo
      (addrEq (ecrecover (hash (mapGet (piAcc s) au) (toU256 (mapGet (piNonce s) au))) v r w) au)

-- The piHas key of the handle h in the pending Pi of au: hash (hash au nonce) h (R45 (a)). A Pi
-- reset increments the nonce, thus the keys of an old Pi do not match again.
def piKey : (s : State) -> (au : Addr) -> (h : U256) -> U256 :=
  fun (s : State) (au : Addr) (h : U256) =>
    hash (hash (addrToU256 au) (toU256 (mapGet (piNonce s) au))) h

-- Entry: add the tuple (id, h) to the pending Pi of the user au (R45 (a)). The caller is au or a
-- proposer. piAcc[au] := hash piAcc[au] (hash id h), piCount[au] + 1, and piHas of h under the
-- current nonce of au.
def addTuple : (env : Env) -> (s : State) -> (au : Addr) -> (id h : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (au : Addr) (id h : U256) =>
    flagIf (byUserOrProposer env s au)
      (some (pair
        (makeState (ctr s) (minDeposit s) (nA s) (genesis s) (slotLength s)
          (aucsPerSlot s) (aucItem s) (aucStart s) (aucEnd s) (amount s) (leaf s) (nextLeaf s)
          (rootAt s) (filled s) (inactiveSince s) (slashed s) (proposer s)
          (mapSet (piAcc s) au (hash (mapGet (piAcc s) au) (hash id h)))
          (mapSet (piCount s) au (natAdd (mapGet (piCount s) au) 1)) (piNonce s)
          (mapSet (piHas s) (piKey s au h) flagYes) (winner s) (price s))
        nil))
      none

-- Entry: the user au is active again. The caller is au or a proposer, au is inactive, and (v, r, w)
-- is a signature of au over hash piAcc[au] piNonce[au]. The timer stops (0), and the pending Pi resets: piAcc and
-- piCount are 0, and piNonce + 1.
def updateActivity : (env : Env) -> (s : State) -> (au : Addr) -> (v : Nat) -> (r w : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (au : Addr) (v : Nat) (r w : U256) =>
    flagIf (byUserOrProposer env s au)
      (flagIf (natEq (mapGet (inactiveSince s) au) 0)
        none
        (flagIf (signedBy s au v r w)
          (some (pair
            (makeState (ctr s) (minDeposit s) (nA s) (genesis s) (slotLength s)
              (aucsPerSlot s) (aucItem s) (aucStart s) (aucEnd s) (amount s) (leaf s) (nextLeaf s)
              (rootAt s) (filled s) (mapSet (inactiveSince s) au 0) (slashed s) (proposer s)
              (mapSet (piAcc s) au 0u) (mapSet (piCount s) au 0)
              (mapSet (piNonce s) au (natAdd (mapGet (piNonce s) au) 1)) (piHas s) (winner s) (price s))
            nil))
          none))
      none

-- Entry: mark the handle hu as slashed. Two valid proofs for hu (R50 (a)) with two different
-- commitments cm1 and cm2 (R75 (a)) show a double commit. Each commit is its slot (the slot of
-- root_s), its cm and its proof of 8 words: 1 + 2 (1 + 1 + 8) = 21 words (O102). Any caller (R44 (a)).
def slashUsr : (env : Env) -> (s : State) -> (hu : U256) ->
  (slot1 : Nat) -> (cm1 a1x a1y b1xi b1xr b1yi b1yr c1x c1y : U256) ->
  (slot2 : Nat) -> (cm2 a2x a2y b2xi b2xr b2yi b2yr c2x c2y : U256) ->
  Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (hu : U256) (slot1 : Nat) (cm1 a1x a1y b1xi b1xr b1yi b1yr c1x c1y : U256)
    (slot2 : Nat) (cm2 a2x a2y b2xi b2xr b2yi b2yr c2x c2y : U256) =>
    flagIf (u256Eq cm1 cm2)
      none
      (flagIf (eligible s hu slot1 cm1 (proofOf a1x a1y b1xi b1xr b1yi b1yr c1x c1y))
        (flagIf (eligible s hu slot2 cm2 (proofOf a2x a2y b2xi b2xr b2yi b2yr c2x c2y))
          (some (pair
            (makeState (ctr s) (minDeposit s) (nA s) (genesis s) (slotLength s)
              (aucsPerSlot s) (aucItem s) (aucStart s) (aucEnd s) (amount s) (leaf s) (nextLeaf s)
              (rootAt s) (filled s) (inactiveSince s) (mapSet (slashed s) hu flagYes) (proposer s)
              (piAcc s) (piCount s) (piNonce s) (piHas s) (winner s) (price s))
            nil))
          none)
        none)

-- The state after the user au leaves (slash or withdraw): the deposit and the leaf are 0, and the
-- pending Pi resets. The timer also stops (0): a later deposit of au starts active, thus it cannot
-- use the old timer to withdraw at once.
def clearUser : (s : State) -> (au : Addr) -> State :=
  fun (s : State) (au : Addr) =>
    makeState (ctr s) (minDeposit s) (nA s) (genesis s) (slotLength s)
      (aucsPerSlot s) (aucItem s) (aucStart s) (aucEnd s) (mapSet (amount s) au 0u) (mapSet (leaf s) au 0u)
      (nextLeaf s) (rootAt s) (filled s) (mapSet (inactiveSince s) au 0) (slashed s) (proposer s)
      (mapSet (piAcc s) au 0u) (mapSet (piCount s) au 0)
      (mapSet (piNonce s) au (natAdd (mapGet (piNonce s) au) 1)) (piHas s) (winner s) (price s)

-- Entry: slash the user au. (v, r, w) signs hash piAcc[au] piNonce[au], the pending Pi of au has
-- the handle hu, and hu is slashed. Any caller (R44 (a)). The deposit stays with the contract.
def slash : (env : Env) -> (s : State) -> (au : Addr) -> (hu : U256) -> (v : Nat) -> (r w : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (au : Addr) (hu : U256) (v : Nat) (r w : U256) =>
    flagIf (signedBy s au v r w)
      (flagIf (mapGet (piHas s) (piKey s au hu))
        (flagIf (mapGet (slashed s) hu) (some (pair (clearUser s au) nil)) none)
        none)
      none

-- Entry: pay minDeposit of the asset to the user au (PLAN section 2), and au leaves. au has a
-- deposit, au is inactive for at least nA slots, and (v, r, w) signs hash piAcc[au] piNonce[au].
-- The timer is the start slot + 1, thus the slot check is timer + nA <= slot + 1.
def withdraw : (env : Env) -> (s : State) -> (au : Addr) -> (v : Nat) -> (r w : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (au : Addr) (v : Nat) (r w : U256) =>
    flagIf (u256Eq (mapGet (amount s) au) 0u)
      none
      (flagIf (natEq (mapGet (inactiveSince s) au) 0)
        none
        (flagIf (natLe (natAdd (mapGet (inactiveSince s) au) (nA s)) (natAdd (slotOf s (now env)) 1))
          (flagIf (signedBy s au v r w)
            (some (pair (clearUser s au) (cons (pay asset au (minDeposit s)) nil)))
            none)
          none))

-- Entry: settle the auction id (R43 (a)). The caller is the winner at the price bid and pays bid of
-- the asset. The caller has a deposit (R73 (a)), the auction exists (id < ctr), it has no winner,
-- and its end slot has passed. The choice of the winner from the sealed bids is S6 (processBid).
def settle : (env : Env) -> (s : State) -> (id bid : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (id bid : U256) =>
    flagIf (u256Eq (mapGet (amount s) (caller env)) 0u)
      none
      (flagIf (u256Le (ctr s) id)
        none
        (flagIf (u256Eq (addrToU256 (mapGet (winner s) id)) 0u)
          (flagIf (natLe (slotOf s (now env)) (mapGet (aucEnd s) id))
            none
            (some (pair
              (makeState (ctr s) (minDeposit s) (nA s) (genesis s) (slotLength s)
                (aucsPerSlot s) (aucItem s) (aucStart s) (aucEnd s) (amount s) (leaf s) (nextLeaf s)
                (rootAt s) (filled s) (inactiveSince s) (slashed s) (proposer s)
                (piAcc s) (piCount s) (piNonce s) (piHas s)
                (mapSet (winner s) id (caller env)) (mapSet (price s) id bid))
              (cons (pull asset (caller env) (self env) bid) nil))))
          none))

-- Views: one view per field of an auction record (O8), the root of a slot, the deposit of a user,
-- a slashed handle, and the count of the pending tuples of a user.
def aucItemOf : (env : Env) -> (s : State) -> (id : U256) -> U256 :=
  fun (env : Env) (s : State) (id : U256) => mapGet (aucItem s) id
def aucStartOf : (env : Env) -> (s : State) -> (id : U256) -> Nat :=
  fun (env : Env) (s : State) (id : U256) => mapGet (aucStart s) id
def aucEndOf : (env : Env) -> (s : State) -> (id : U256) -> Nat :=
  fun (env : Env) (s : State) (id : U256) => mapGet (aucEnd s) id
def winnerOf : (env : Env) -> (s : State) -> (id : U256) -> Addr :=
  fun (env : Env) (s : State) (id : U256) => mapGet (winner s) id
def priceOf : (env : Env) -> (s : State) -> (id : U256) -> U256 :=
  fun (env : Env) (s : State) (id : U256) => mapGet (price s) id
def rootOf : (env : Env) -> (s : State) -> (slot : Nat) -> U256 :=
  fun (env : Env) (s : State) (slot : Nat) => mapGet (rootAt s) slot
def depositOf : (env : Env) -> (s : State) -> (au : Addr) -> U256 :=
  fun (env : Env) (s : State) (au : Addr) => mapGet (amount s) au
def isSlashed : (env : Env) -> (s : State) -> (h : U256) -> Flag :=
  fun (env : Env) (s : State) (h : U256) => mapGet (slashed s) h
def pendingOf : (env : Env) -> (s : State) -> (au : Addr) -> Nat :=
  fun (env : Env) (s : State) (au : Addr) => mapGet (piCount s) au
