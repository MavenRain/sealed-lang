-- flagYes when the proof n (proof1 for 1, proof2 for 2, else proof3) is valid for the six words:
-- rootHi, rootLo, huHi, huLo, cmHi, cmLo. The words of statementN give flagYes for the proof N. One
-- other word gives flagNo. The flagIf selects a Flag, not a proof: K4c does not lower a proof value
-- at a word position.
def check : (env : Env) -> (s : State) -> (n : U256) -> (rootHi rootLo huHi huLo cmHi cmLo : U256) -> Flag :=
  fun (env : Env) (s : State) (n : U256) (rootHi rootLo huHi huLo cmHi cmLo : U256) =>
    flagIf (u256Eq n 1u)
      (verify eligibilityKey (cons rootHi (cons rootLo (cons huHi (cons huLo (cons cmHi (cons cmLo nil)))))) proof1)
      (flagIf (u256Eq n 2u)
        (verify eligibilityKey (cons rootHi (cons rootLo (cons huHi (cons huLo (cons cmHi (cons cmLo nil)))))) proof2)
        (verify eligibilityKey (cons rootHi (cons rootLo (cons huHi (cons huLo (cons cmHi (cons cmLo nil)))))) proof3))
