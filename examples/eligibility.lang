-- The eligibility proof pi^m on the chain (S11 step 11.2, docs/PLAN.md O106). circuits/gen.sh makes
-- a test setup (R3 (a): a local powers of tau, one contributor, a beacon) for
-- circuits/eligibility.circom and three proofs for circuits/input-1.json, input-2.json and
-- input-3.json. build/vkfmt (test/vkfmt.c) turns the key, the proofs and the public words into the
-- constants below. The statement of a proof is six public words, two 128-bit limbs (high, low) for
-- each of root, hu and cm (O102). The three proofs have one root (the fixture tree of
-- circuits/fixture.circom). Proofs 1 and 2 have one handle hu and two commitments cm1 and cm2; proof
-- 3 has the handle hu' of the other leaf. test/precompile.sh calls check on the chain. `langc eval`
-- keeps verify stuck (R17).
state State := makeState (count : Nat)

def init : State := makeState 0

-- The proof (A, (B, C)) of 8 call words. A and C are G1 points. B is a G2 point in the EIP-197 order.
def proofOf : (ax ay bxi bxr byi byr cx cy : U256) -> VerifyProof :=
  fun (ax ay bxi bxr byi byr cx cy : U256) =>
    pair (pair ax ay) (pair (pair (pair bxi bxr) (pair byi byr)) (pair cx cy))

